# --- Required ---
# Fine-grained PAT with Issues: read/write, Pull requests: read/write, Contents: read
GITHUB_TOKEN=ghp_your_token_here

# At least one LLM provider key
ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here

# --- Optional ---
# When true the agent reasons end-to-end but never mutates GitHub
DRY_RUN=true

# Path to the repository policy / automation config
TRIAGE_CONFIG=config.yaml

# SQLite database for the audit trail
TRIAGE_DB_PATH=triage_agent.db

# json | console
LOG_FORMAT=json
LOG_LEVEL=INFO
